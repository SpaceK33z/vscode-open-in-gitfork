{
  "name": "vscode-open-in-gitfork",
  "displayName": "Open in Fork",
  "description": "Adds a command for opening the current project in Fork (a Git client).",
  "icon": "resources/logo-128x128.png",
  "version": "1.0.3",
  "license": "MIT",
  "main": "out/src/extension.js",
  "publisher": "spacek33z",
  "contributes": {
    "commands": [
      {
        "command": "openInGitFork.open",
        "title": "Open in Fork",
        "icon": {
          "light": "resources/fork-light.svg",
          "dark": "resources/fork-dark.svg"
        }
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "openInGitFork.open",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "publish": "vsce publish && npm publish",
    "compile": "tsc -watch -p ./"
  },
  "bugs": {
    "url": "https://github.com/SpaceK33z/vscode-open-in-gitfork/issues"
  },
  "author": {
    "name": "Kees Kluskens",
    "email": "kees@webduck.nl"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SpaceK33z/vscode-open-in-gitfork.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "keywords": [
    "vscode",
    "vsc",
    "extension",
    "open in",
    "gitfork"
  ],
  "categories": [
    "Other"
  ],
  "dependencies": {
    "lodash": "^4.17.4",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.2",
    "@types/vscode": "~1.74.0",
    "tslint": "^6.1.3",
    "typescript": "^5.9.3"
  }
}
